ANTHROPIC_API_KEY=sk-ant-your-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
ALLOWED_ORIGINS=http://localhost:5173

# Razorpay — payments (LIVE keys start with rzp_live_, test keys rzp_test_)
# Both are read ONLY by the backend. NEVER put the secret in the frontend.
RAZORPAY_KEY_ID=rzp_live_your-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here

# Resend — transactional email (admin notification on account deletion)
RESEND_API_KEY=re_your-resend-key-here

# Adzuna — job search aggregator (free tier, India). Register a free app (no card)
# at https://developer.adzuna.com to get the id + key. If unset, Find Jobs falls
# back to generating LinkedIn search links (the previous behaviour).
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
