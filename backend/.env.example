ANTHROPIC_API_KEY=sk-ant-your-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
ALLOWED_ORIGINS=http://localhost:5173

# Razorpay — payments (LIVE keys start with rzp_live_, test keys rzp_test_)
# Both are read ONLY by the backend. NEVER put the secret in the frontend.
RAZORPAY_KEY_ID=rzp_live_your-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here

# Resend — transactional email (admin notification on account deletion)
RESEND_API_KEY=re_your-resend-key-here

# JSearch — job search aggregator (RapidAPI, free Basic plan = 200 req/mo).
# Subscribe at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch and paste the
# X-RapidAPI-Key here. If unset, the aggregator layer is skipped (career-page jobs +
# LinkedIn/Naukri/Indeed deep-links still work).
JSEARCH_API_KEY=your-rapidapi-jsearch-key

# Secret guarding POST /api/jobs/refresh-ats (refreshes the curated career-page job
# cache). Invent any long random string; the daily cron must send ?token=<this>.
ATS_REFRESH_TOKEN=your-long-random-refresh-token
